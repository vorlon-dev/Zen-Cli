{
  "name": "zen-cli",
  "version": "1.0.0",
  "description": "Zen CLI — OTA app updates for Android backed by your own GitHub repo. Publish APKs, roll out in-app updates, rollback in seconds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/zen-ota.git"
  },
  "bin": {
    "zen": "bin/zen.js"
  },
  "files": [
    "bin/",
    "checksums.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ota",
    "android",
    "apk",
    "auto-update",
    "in-app-update",
    "cli",
    "github-releases",
    "mobile",
    "release-management"
  ],
  "zen": {
    "repo": "YOUR_USERNAME/zen-ota",
    "tagPrefix": "zen-cli-v"
  },
  "optionalDependencies": {
    "@zen/cli-linux-x64": "1.0.0",
    "@zen/cli-linux-arm64": "1.0.0",
    "@zen/cli-darwin-x64": "1.0.0",
    "@zen/cli-darwin-arm64": "1.0.0",
    "@zen/cli-win32-x64": "1.0.0"
  }
}
