<?xml version="1.0" encoding="utf-8"?>
<!--
  Zen OTA Android library manifest.

  Manifest merger note: only INTERNET is mandatory and declared here.
  Apps using the SDK should additionally declare (in their own manifest):

    <!-- recommended: user-confirmation installs on API 26+ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- optional: only if ZenConfig.showProgressNotification = true (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  No components are declared: ZenUpdater registers its install-status
  BroadcastReceiver dynamically at runtime, so nothing needs merging.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
